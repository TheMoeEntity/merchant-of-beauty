# Copy to .env.local and fill in. Never commit real values.

# Database (Neon PostgreSQL)
DATABASE_URL=

# Auth.js / NextAuth v5 — generate with: npx auth secret
AUTH_SECRET=

# Redis (rate limiting)
REDIS_URL=

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel cron (sent as Bearer token to /api/cron/*)
CRON_SECRET=

# Used only by `npm run db:seed` to create the first owner account
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
